# =========================================
# RR-Fuzz配置文件 - Replay模式
# =========================================
# 用于重放已录制的trace
#
# 使用方法:
#   # 1. 使用二进制trace（推荐）
#   RR_CONFIG_FILE=./rr_config.replay.template \
#   qemu-x86_64 /usr/bin/target
#
#   # 2. 使用strace文本trace（兼容模式）
#   RR_CONFIG_FILE=./rr_config.replay.template \
#   RR_STRACE_MODE=True \
#   qemu-x86_64 /usr/bin/target
#
# 注意：
#   1. mode字段会自动识别，无需额外设置RR_MODE环境变量
#   2. 默认使用二进制trace（.dat），若使用strace文本需设置RR_STRACE_MODE=True
# =========================================

# === 核心配置 ===
# 启用RR-Fuzz
enabled=true

# 运行模式（自动识别）
mode=replay

# Trace文件输入路径（必须是已录制的文件）
trace_file=/home/webfuzz/Documents/qemu/linux-user/rr_fuzzing/strace-record-ls.txt

# === Debug配置 ===
# 调试级别: 0=off, 1=error, 2=warn, 3=info, 4=verbose, 5=trace
debug_level=4

# 调试日志输出文件 (默认: stderr)
# debug_file=./debug-replay.log

# === 注意事项 ===
# 1. 默认读取二进制trace（.dat）；若使用文本trace需设置RR_STRACE_MODE=True
# 2. trace_file 必须是已经录制好的trace文件
# 3. 二进制trace性能更好且更精确，推荐使用
# 4. 可以通过 debug_level 控制日志输出详细程度

# === 不需要的参数（Replay模式不使用） ===
# shared_memory_name - Fuzzing模式专用
# cmd_pipe_path - Fuzzing模式专用
# status_pipe_path - Fuzzing模式专用
# fork_strategy - Fuzzing模式专用
# fork_threshold - Fuzzing模式专用

