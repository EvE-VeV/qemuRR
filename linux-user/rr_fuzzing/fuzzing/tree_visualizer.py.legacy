#!/usr/bin/env python3
"""
Syscall Tree Visualizer for RR-Fuzz
从 trace 文件生成真正的树状可视化（使用 D3.js tree layout）

基于 realtime_tree_visualizer.py 的可视化代码
"""

import sys
import json
from pathlib import Path
from typing import List, Dict, Optional
from dataclasses import dataclass, field

# Add parent directory to path for trace_analyzer import
sys.path.insert(0, str(Path(__file__).parent.parent))
from trace_analyzer import TraceAnalyzer


@dataclass
class TreeNode:
    """树节点 - 增强版：包含fuzzing执行统计信息"""
    node_id: int
    syscall_index: int
    syscall_name: str
    retval: str = "?"
    is_pure: bool = False
    children: List['TreeNode'] = field(default_factory=list)
    trace_source: str = ""  # 来自哪个 trace
    
    # ✅ 新增：Fuzzing执行统计信息
    exec_count: int = 0                           # 被执行了多少次
    fork_count: int = 0                           # fork了多少次
    mutation_applied: bool = False                # 是否应用了mutation
    mutation_types: List[str] = field(default_factory=list)  # 使用的mutation类型
    arg_modifications: Dict = field(default_factory=dict)    # 参数修改记录
    new_coverage_found: int = 0                   # 发现的新edges数量


class TreeVisualizer:
    """
    树状可视化生成器
    
    ✅ P0-2 FIX: 真正的树结构合并
    - 识别多个trace之间的共同前缀
    - 在fork点创建分支
    - 构建统一的syscall执行树
    """
    
    # ✅ FIX: Class-level cache to avoid re-parsing
    _trace_cache = {}  # {trace_file: TraceAnalyzer}
    
    def __init__(self):
        self.traces: List[Dict] = []  # 存储 {'label': ..., 'nodes': [TreeNode, ...]}
        self.node_counter = 0
        self.unified_root = None  # ✅ P0-2: 统一的根节点，用于真正的树合并
    
    def add_trace(self, trace_file: str, label: Optional[str] = None, analyzer=None, 
                  stats: Optional[Dict] = None) -> bool:
        """
        ✅ P0-2: 添加trace并合并到统一的树中（真正的树结构）
        
        Args:
            trace_file: Trace file path
            label: Display label (optional)
            analyzer: Pre-parsed TraceAnalyzer (optional, to avoid re-parsing)
            stats: Fuzzing statistics dict (optional) with keys:
                   - syscall_stats: {syscall_index: {exec_count, fork_count, mutations, ...}}
                   - trace_exec_count: number of times trace was executed
                   - new_coverage: number of new edges found
        """
        if label is None:
            label = Path(trace_file).stem
        
        try:
            # ✅ FIX: Use provided analyzer or cached one
            if analyzer is None:
                if trace_file in TreeVisualizer._trace_cache:
                    analyzer = TreeVisualizer._trace_cache[trace_file]
                else:
                    analyzer = TraceAnalyzer(trace_file)
                    TreeVisualizer._trace_cache[trace_file] = analyzer
            
            if not analyzer.syscalls:
                print(f"[TreeViz] ⚠️  No syscalls in {label}")
                return False
            
            # 获取统计信息（如果提供）
            syscall_stats = {}
            if stats and 'syscall_stats' in stats:
                syscall_stats = stats['syscall_stats']
            
            # ═══════════════════════════════════════════════════════════════
            # P0-2: 树合并逻辑（Critical Fix!）
            # ═══════════════════════════════════════════════════════════════
            
            # 如果是第一个trace，创建根节点
            if self.unified_root is None:
                self.unified_root = TreeNode(
                    node_id=self.node_counter,
                    syscall_index=-1,
                    syscall_name="RR-Fuzz Root",
                    retval="",
                    is_pure=False,
                    children=[],
                    trace_source="root"
                )
                self.node_counter += 1
            
            # ✅ FIX: 选项C - 混合模式（智能合并 + 在差异点fork）
            # 从根节点开始，逐个syscall向下，智能合并或fork
            current = self.unified_root
            merge_stats = {'matched': 0, 'forked': 0, 'created': 0}
            
            for i, sc in enumerate(analyzer.syscalls):
                is_pure = getattr(sc, 'has_aux_data', False) or sc.category == 'pure_replay'
                sc_stat = syscall_stats.get(sc.index, {})
                retval_str = str(getattr(sc, 'retval', 0))
                has_mutation = sc_stat.get('mutation_applied', False)
                
                # ✅ 查找完全匹配的子节点
                # 匹配条件：syscall名称、索引、返回值、mutation状态都相同
                matching_child = None
                
                for child in current.children:
                    # 条件1: syscall名称相同
                    if child.syscall_name != sc.name:
                        continue
                    
                    # 条件2: syscall索引相同
                    if child.syscall_index != sc.index:
                        continue
                    
                    # 条件3: 返回值相同（对于IO syscalls特别重要）
                    if child.retval != retval_str:
                        continue
                    
                    # 条件4: mutation状态相同 - ✅ CRITICAL: mutation点应该fork
                    if child.mutation_applied != has_mutation:
                        continue  # mutation状态不同，创建新分支
                    
                    # ✅ 选项B: 条件5 - mutation_types相同才合并
                    # 不同的mutation类型应该产生不同的分支
                    if has_mutation:
                        child_mut_types = set(child.mutation_types)
                        sc_mut_types = set(sc_stat.get('mutation_types', []))
                        
                        if child_mut_types != sc_mut_types:
                            continue  # mutation类型不同，创建新分支
                    
                    # ✅ 找到完全匹配的节点，合并
                    matching_child = child
                    matching_child.exec_count += sc_stat.get('exec_count', 0)
                    matching_child.fork_count += 1
                    
                    # 更新trace_source（记录访问历史）
                    if label not in matching_child.trace_source:
                        if matching_child.trace_source:
                            matching_child.trace_source += f", {label}"
                        else:
                            matching_child.trace_source = label
                    
                    # 更新mutation信息
                    if has_mutation:
                        new_types = sc_stat.get('mutation_types', [])
                        matching_child.mutation_types = list(set(
                            matching_child.mutation_types + new_types
                        ))
                    
                    matching_child.new_coverage_found += sc_stat.get('new_coverage', 0)
                    merge_stats['matched'] += 1
                    break
                
                if matching_child:
                    # 找到匹配，沿着这条路径继续
                    current = matching_child
                else:
                    # 没有找到匹配，创建新分支（fork点）
                    # 检查是否已有同名syscall但不同结果的子节点（这将是fork点）
                    has_sibling_with_same_name = any(
                        child.syscall_name == sc.name 
                        for child in current.children
                    )
                    if has_sibling_with_same_name:
                        merge_stats['forked'] += 1
                    
                    new_node = TreeNode(
                        node_id=self.node_counter,
                        syscall_index=sc.index,
                        syscall_name=sc.name,
                        retval=retval_str,
                        is_pure=is_pure,
                        children=[],
                        trace_source=label,
                        # ✅ 添加fuzzing统计信息
                        exec_count=sc_stat.get('exec_count', 0),
                        fork_count=sc_stat.get('fork_count', 0),
                        mutation_applied=has_mutation,
                        mutation_types=sc_stat.get('mutation_types', []),
                        arg_modifications=sc_stat.get('arg_modifications', {}),
                        new_coverage_found=sc_stat.get('new_coverage', 0)
                    )
                    self.node_counter += 1
                    merge_stats['created'] += 1
                    
                    # 添加为当前节点的子节点
                    current.children.append(new_node)
                    current = new_node
            
            # 记录trace信息
            self.traces.append({
                'label': label,
                'syscall_count': len(analyzer.syscalls),
                'merge_stats': merge_stats
            })
            
            print(f"[TreeViz] ✅ Merged trace: {label} "
                  f"({len(analyzer.syscalls)} syscalls, "
                  f"matched={merge_stats['matched']}, "
                  f"forked={merge_stats['forked']}, "
                  f"created={merge_stats['created']})")
            return True
        
        except Exception as e:
            print(f"[TreeViz] ❌ Failed to parse {trace_file}: {e}")
            import traceback
            traceback.print_exc()
            return False
    
    def generate_html(self, output_file: str) -> bool:
        """✅ P0-2: 生成树状 HTML 可视化（使用统一的根节点）"""
        if not self.traces:
            print("[TreeViz] ⚠️  No traces to visualize")
            return False
        
        if self.unified_root is None:
            print("[TreeViz] ⚠️  No unified root (no traces added successfully)")
            return False
        
        # ✅ P0-2: 直接使用已合并的统一根节点
        tree_json = self._node_to_json(self.unified_root)
        
        # 统计信息
        total_syscalls = sum(t['syscall_count'] for t in self.traces)
        total_matched = sum(t['merge_stats']['matched'] for t in self.traces)
        total_forked = sum(t['merge_stats']['forked'] for t in self.traces)
        
        stats = {
            'total_traces': len(self.traces),
            'total_nodes': self.node_counter,
            'total_syscalls': total_syscalls,
            'matched_nodes': total_matched,
            'fork_points': total_forked,
            'trace_labels': [t['label'] for t in self.traces]
        }
        
        # 生成 HTML（使用 realtime_tree_visualizer.py 的样式和布局）
        html = self._generate_html_content(tree_json, stats)
        
        try:
            with open(output_file, 'w') as f:
                f.write(html)
            print(f"[TreeViz] ✅ Generated: {output_file}")
            return True
        except Exception as e:
            print(f"[TreeViz] ❌ Failed to write {output_file}: {e}")
            return False
    
    def _node_to_json(self, node: TreeNode, depth: int = 0, visited: set = None) -> dict:
        """节点转 JSON（带循环检测和深度保护）"""
        if visited is None:
            visited = set()
        
        if node.node_id in visited:
            return {
                'node_id': node.node_id,
                'syscall_name': f"⚠️ CIRCULAR: {node.syscall_name}",
                'error': 'circular_reference',
                'children': []
            }
        
        if depth > 500:
            return {
                'node_id': node.node_id,
                'syscall_name': f"⚠️ DEPTH_LIMIT: {node.syscall_name}",
                'error': 'max_depth_exceeded',
                'children': []
            }
        
        visited.add(node.node_id)
        
        children_json = []
        for child in node.children:
            child_json = self._node_to_json(child, depth + 1, visited)  # ✅ 修复: 不要copy visited
            children_json.append(child_json)
        
        return {
            'node_id': node.node_id,
            'syscall_index': node.syscall_index,
            'syscall_name': node.syscall_name,
            'retval': node.retval,
            'is_pure': node.is_pure,
            'trace_source': node.trace_source,
            # ✅ 新增：Fuzzing统计信息
            'exec_count': node.exec_count,
            'fork_count': node.fork_count,
            'mutation_applied': node.mutation_applied,
            'mutation_types': node.mutation_types,
            'arg_modifications': node.arg_modifications,
            'new_coverage_found': node.new_coverage_found,
            'children': children_json
        }
    
    def _generate_html_content(self, tree_json: dict, stats: dict) -> str:
        """生成 HTML 内容（复用 realtime_tree_visualizer.py 的可视化代码）"""
        return f'''<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>RR-Fuzz Syscall Tree</title>
    <script src="https://d3js.org/d3.v7.min.js"></script>
    <style>
        * {{ margin: 0; padding: 0; box-sizing: border-box; }}
        body {{
            font-family: 'Segoe UI', system-ui, sans-serif;
            background: linear-gradient(135deg, #0f0c29 0%, #302b63 50%, #24243e 100%);
            color: #e0e0e0;
            overflow: hidden;
        }}
        #header {{
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            background: rgba(15, 12, 41, 0.95);
            padding: 15px 25px;
            border-bottom: 2px solid #667eea;
            z-index: 100;
        }}
        h1 {{
            font-size: 22px;
            color: #667eea;
            margin-bottom: 8px;
        }}
        #stats {{
            display: flex;
            gap: 20px;
            font-size: 13px;
        }}
        .stat-value {{
            font-weight: bold;
            color: #48c774;
        }}
        #tree-container {{
            position: absolute;
            top: 90px;
            left: 0;
            right: 0;
            bottom: 0;
        }}
        #legend {{
            position: fixed;
            top: 100px;
            right: 20px;
            background: rgba(15, 12, 41, 0.9);
            padding: 15px;
            border-radius: 8px;
            border: 1px solid #667eea;
            font-size: 12px;
            z-index: 200;
        }}
        .legend-item {{
            display: flex;
            align-items: center;
            margin-bottom: 8px;
        }}
        .legend-circle {{
            width: 12px;
            height: 12px;
            border-radius: 50%;
            margin-right: 8px;
        }}
        .node circle {{
            fill: #667eea;
            stroke: #5a4fcf;
            stroke-width: 2px;
            cursor: pointer;
        }}
        .node circle:hover {{
            fill: #764ba2;
        }}
        .node.root circle {{
            fill: #48c774;
        }}
        .node.pure circle {{
            fill: #2ecc71;
        }}
        .node.hybrid circle {{
            fill: #ff9f43;
        }}
        .node.mutated circle {{
            fill: #764ba2;
        }}
        .node text {{
            font-size: 10px;
            fill: #e0e0e0;
            text-anchor: start;
            pointer-events: none;
        }}
        .link {{
            fill: none;
            stroke: rgba(102, 126, 234, 0.4);
            stroke-width: 2px;
        }}
        .tooltip {{
            position: absolute;
            background: rgba(15, 12, 41, 0.98);
            border: 1px solid #667eea;
            border-radius: 5px;
            padding: 12px;
            pointer-events: none;
            display: none;
            font-size: 13px;
            z-index: 200;
        }}
    </style>
</head>
<body>
    <div id="header">
        <h1>🌳 RR-Fuzz Syscall Execution Tree (Merged View)</h1>
        <div id="stats">
            <div>Traces: <span class="stat-value">{stats['total_traces']}</span></div>
            <div>Tree Nodes: <span class="stat-value">{stats['total_nodes']}</span></div>
            <div>Syscalls: <span class="stat-value">{stats.get('total_syscalls', stats['total_nodes'])}</span></div>
            <div>Matched: <span class="stat-value">{stats.get('matched_nodes', 0)}</span></div>
            <div>Fork Points: <span class="stat-value" style="color: #ff9f43;">{stats.get('fork_points', 0)}</span></div>
        </div>
    </div>
    
    <div id="tree-container"></div>
    
    <div id="legend">
        <h3 style="margin-bottom: 10px; color: #667eea;">节点类型</h3>
        <div class="legend-item">
            <div class="legend-circle" style="background: #48c774;"></div>
            <span>根节点</span>
        </div>
        <div class="legend-item">
            <div class="legend-circle" style="background: #2ecc71;"></div>
            <span>Pure Replay</span>
        </div>
        <div class="legend-item">
            <div class="legend-circle" style="background: #ff9f43;"></div>
            <span>Hybrid Replay</span>
        </div>
        <hr style="border-color: #667eea; margin: 10px 0;">
        <div class="legend-item">
            <div class="legend-circle" style="background: #667eea; border: 2px solid #ff9f43;"></div>
            <span style="color: #ff9f43;">Fork Point (多子节点)</span>
        </div>
        <div class="legend-item">
            <div class="legend-circle" style="background: #764ba2;"></div>
            <span>Mutated Syscall</span>
        </div>
    </div>
    <div class="tooltip" id="tooltip"></div>
    
    <script>
        const treeData = {json.dumps(tree_json, indent=2)};
        
        const width = window.innerWidth;
        const height = window.innerHeight - 100;
        
        const svg = d3.select("#tree-container")
            .append("svg")
            .attr("width", width)
            .attr("height", height);
        
        const g = svg.append("g")
            .attr("transform", "translate(80, 40)");
        
        const zoom = d3.zoom()
            .scaleExtent([0.1, 5])
            .on("zoom", (event) => g.attr("transform", event.transform));
        svg.call(zoom);
        
        const tree = d3.tree()
            .nodeSize([30, 200])
            .separation((a, b) => {{
                if (a.parent === b.parent) {{
                    const siblings = a.parent ? a.parent.children.length : 1;
                    if (siblings > 80) return 0.5;
                    if (siblings > 40) return 0.7;
                    if (siblings > 20) return 1.0;
                    return 1.5;
                }}
                return 2;
            }});
        
        const root = d3.hierarchy(treeData);
        tree(root);
        
        // Links
        g.selectAll(".link")
            .data(root.links())
            .enter().append("path")
            .attr("class", "link")
            .attr("d", d3.linkHorizontal()
                .x(d => d.y)
                .y(d => d.x));
        
        // Nodes
        const nodes = g.selectAll(".node")
            .data(root.descendants())
            .enter().append("g")
            .attr("class", d => {{
                let cls = "node";
                if (d.depth === 0) cls += " root";
                else if (d.data.mutation_applied) cls += " mutated";  // ✅ 优先标记mutated
                else if (d.data.is_pure) cls += " pure";
                else cls += " hybrid";
                return cls;
            }})
            .attr("transform", d => `translate(${{d.y}},${{d.x}})`);
        
        nodes.append("circle")
            .attr("r", d => {{
                if (d.depth === 0) return 10;
                // Fork点稍微大一些
                if (d.children && d.children.length > 1) return 7;
                return 5;
            }})
            .style("stroke-width", d => {{
                // Fork点有特殊边框
                if (d.children && d.children.length > 1) return "3px";
                return "2px";
            }})
            .style("stroke", d => {{
                // Fork点用橙色边框
                if (d.children && d.children.length > 1) return "#ff9f43";
                return "#5a4fcf";
            }});
        
        nodes.append("text")
            .attr("dy", -12)
            .text(d => d.data.syscall_name);
        
        nodes.append("text")
            .attr("dy", 18)
            .style("font-size", "9px")
            .style("fill", "#888")
            .text(d => `[${{d.data.syscall_index}}]`);
        
        const tooltip = d3.select("#tooltip");
        nodes.on("mouseover", function(event, d) {{
            // ✅ 增强tooltip显示fuzzing统计信息
            
            // Fork点信息
            let forkInfo = '';
            if (d.children && d.children.length > 1) {{
                forkInfo = `
                    <hr style="border-color: #667eea; margin: 8px 0;">
                    <b style="color: #ff9f43;">🔀 Fork Point:</b><br>
                    <span style="color: #48c774;">YES</span> - ${{d.children.length}} branches
                `;
            }}
            
            let mutationInfo = '';
            if (d.data.mutation_applied) {{
                mutationInfo = `
                    <hr style="border-color: #667eea; margin: 8px 0;">
                    <b style="color: #764ba2;">🎯 Mutation Info:</b><br>
                    Applied: <span style="color: #48c774;">YES</span><br>
                    Types: ${{d.data.mutation_types.join(', ') || 'N/A'}}<br>
                    Arg Mods: ${{Object.keys(d.data.arg_modifications || {{}}).length}} args
                `;
            }}
            
            let execInfo = '';
            if (d.data.exec_count > 0 || d.data.fork_count > 0) {{
                execInfo = `
                    <hr style="border-color: #667eea; margin: 8px 0;">
                    <b style="color: #48c774;">📊 Execution Stats:</b><br>
                    Exec Count: ${{d.data.exec_count}}<br>
                    Fork Count: ${{d.data.fork_count}}<br>
                    New Coverage: ${{d.data.new_coverage_found}} edges
                `;
            }}
            
            tooltip.style("display", "block")
                .html(`
                    <b>${{d.data.syscall_name}}</b><br>
                    Index: ${{d.data.syscall_index}}<br>
                    Return: ${{d.data.retval}}<br>
                    Source: ${{d.data.trace_source}}<br>
                    Type: ${{d.data.is_pure ? "Pure Replay" : "Hybrid Replay"}}
                    ${{forkInfo}}
                    ${{execInfo}}
                    ${{mutationInfo}}
                `)
                .style("left", (event.pageX + 10) + "px")
                .style("top", (event.pageY - 10) + "px");
        }})
        .on("mouseout", () => tooltip.style("display", "none"));
    </script>
</body>
</html>'''


if __name__ == '__main__':
    import argparse
    
    parser = argparse.ArgumentParser(description='Generate syscall tree visualization')
    parser.add_argument('traces', nargs='+', help='Trace files to visualize')
    parser.add_argument('--labels', nargs='+', help='Labels for traces')
    parser.add_argument('-o', '--output', default='syscall_tree.html', help='Output HTML file')
    
    args = parser.parse_args()
    
    viz = TreeVisualizer()
    
    labels = args.labels if args.labels else [None] * len(args.traces)
    
    for trace_file, label in zip(args.traces, labels):
        viz.add_trace(trace_file, label)
    
    if viz.generate_html(args.output):
        print(f"\n✅ Tree visualization generated: {args.output}")
        print(f"   Open in browser: file://{Path(args.output).absolute()}")
    else:
        print("\n❌ Failed to generate tree visualization")
        sys.exit(1)

